# --- Required ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/KF_MAINDB
JWT_ADMIN_SECRET=change-me-to-a-long-random-string
JWT_ADMIN_TTL=7d
# Comma-separated site + dashboard origins, no trailing slash
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- First admin (used by `npm run seed-admin`) ---
SUPERADMIN_EMAIL=admin@kftech.solutions
SUPERADMIN_PASSWORD=ChangeMe123!

# --- Optional: media storage (Cloudflare R2 / any S3-compatible bucket) ---
# Without these, uploads fall back to local disk, which is EPHEMERAL on Render.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourdomain.com

# Render sets PORT automatically; only needed locally
PORT=4000
